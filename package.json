{
  "name": "nestjs-oracledb",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS demo using a minimal portable DeepSec module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --preserve-symlinks --env-file-if-exists=.env dist/main.js",
    "dev": "npm run build && npm start",
    "test": "npm run build && node --preserve-symlinks --test test/*.test.js"
  },
  "dependencies": {
    "@azure/msal-node": "^3.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "nestjs-cls": "7.0.2",
    "nestjs-oracledb-deepsec": "file:packages/nestjs-deepsec",
    "oracledb": "file:../drivers/node-oracledb",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "undici": "7.24.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/oracledb": "^6.10.0",
    "typescript": "^5.9.3"
  }
}
