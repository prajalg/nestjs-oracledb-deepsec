{
  "name": "nestjs-oracledb-deepsec",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal NestJS bridge to the node-oracledb end-user security plugin",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "oracledb": "^26.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "require": "./dist/tokens.js",
      "default": "./dist/tokens.js"
    }
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.0.0"
  },
  "dependencies": {
    "@types/oracledb": "^6.10.0"
  },
  "typesVersions": {
    "*": {
      "tokens": [
        "dist/tokens.d.ts"
      ]
    }
  }
}
