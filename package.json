{
  "name": "nestjs-oracledb",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS demo using a minimal portable DeepSec module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "npm run build:plugin && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "npm run build && npm start",
    "test": "npm run build && node --test test/*.test.js",
    "build:plugin": "npm --prefix packages/nestjs-deepsec run build"
  },
  "dependencies": {
    "@azure/msal-node": "^3.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "express-session": "1.19.0",
    "lru-cache": "11.5.3",
    "memorystore": "1.6.8",
    "nestjs-cls": "7.0.2",
    "nestjs-oracledb-deepsec": "file:packages/nestjs-deepsec",
    "oracledb": "26.0.0",
    "passport": "0.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "undici": "7.24.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/express-session": "1.19.0",
    "@types/node": "^22.0.0",
    "@types/oracledb": "^6.10.0",
    "@types/passport": "1.0.17",
    "typescript": "^5.9.3"
  }
}
