{
  "name": "nestjs-oracledb-deepsec",
  "version": "0.2.0",
  "private": true,
  "description": "NestJS plugin for Oracle Deep Data Security request identity scopes",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "oracledb": "^26.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm test"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "require": "./dist/tokens.js",
      "default": "./dist/tokens.js"
    }
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/passport": "11.0.5",
    "@azure/msal-node": "^3.0.0",
    "express-session": "1.19.0",
    "passport": "0.7.0",
    "nestjs-cls": "7.0.2",
    "oracledb": "26.0.0",
    "@types/oracledb": "^6.10.0",
    "@nestjs/microservices": "11.2.11"
  },
  "typesVersions": {
    "*": {
      "tokens": [
        "dist/tokens.d.ts"
      ]
    }
  }
}
