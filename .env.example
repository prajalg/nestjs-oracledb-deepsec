PORT=7002
HOST=127.0.0.1
NODE_ORACLEDB_USER=your-user
NODE_ORACLEDB_PASSWORD=your-password
NODE_ORACLEDB_CONNECTIONSTRING=localhost:1521/your-service
# Optional for a TCPS wallet connection:
# NODE_ORACLEDB_WALLET_LOCATION=/absolute/path/to/wallet
# NODE_ORACLEDB_WALLET_PASSWORD=your-wallet-password

# Optional proxy for Azure login:
# AZURE_HTTPS_PROXY=http://your-proxy:80

# App-owned Azure login (a public client with device-code flow enabled):
AZURE_USER_CLIENT_ID=your-user-login-public-client-id
AZURE_USER_AUTHORITY=https://login.microsoftonline.com/your-tenant-id
# This user scope targets the middle-tier app, not the database resource:
AZURE_USER_SCOPES=your-middle-tier-resource/user-scope
